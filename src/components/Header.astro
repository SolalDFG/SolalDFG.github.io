---
import { ui, url, routes, anchors, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  paths: { fr: string; en: string };
}
const { lang, paths } = Astro.props;
const t = ui[lang];
const a = anchors[lang];
const home = routes.home(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const links = [
  { href: `${home}#${a.projects}`, label: t.nav.projects },
  { href: `${home}#${a.experience}`, label: t.nav.experience },
  { href: `${home}#${a.skills}`, label: t.nav.skills },
  { href: `${home}#${a.education}`, label: t.nav.education },
  { href: `${home}#${a.contact}`, label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <div class="container-page flex h-14 items-center justify-between gap-4">
    <a href={home} class="group flex items-center gap-2 rounded font-mono text-sm text-text no-underline" aria-label={t.homeLabel}>
      <span class="text-accent" aria-hidden="true">~/</span><span class="font-semibold">solal</span><span
        class="text-dim group-hover:text-accent"
        aria-hidden="true">_</span
      >
    </a>

    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'} class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="rounded-md px-3 py-2 text-muted no-underline transition-colors hover:bg-surface-2 hover:text-text">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={url(paths[other])}
        hreflang={other}
        lang={other}
        class="inline-flex min-h-10 items-center gap-1.5 rounded-md border border-line-strong px-3 font-mono text-xs font-semibold text-text no-underline transition-colors hover:border-accent hover:text-accent"
        title={t.switchLabel}
        aria-label={t.switchLabel}
      >
        <span class={lang === 'fr' ? 'text-accent' : 'text-dim'} aria-hidden="true">FR</span>
        <span class="text-dim" aria-hidden="true">/</span>
        <span class={lang === 'en' ? 'text-accent' : 'text-dim'} aria-hidden="true">EN</span>
      </a>

      <details class="relative md:hidden" data-menu>
        <summary
          class="flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-md border border-line-strong px-3 text-xs font-semibold text-text [&::-webkit-details-marker]:hidden"
        >
          <Icon name="menu" class="h-4 w-4" />
          {t.menu}
        </summary>
        <nav aria-label={lang === 'fr' ? 'Navigation mobile' : 'Mobile navigation'} class="absolute right-0 mt-2 w-56 rounded-lg border border-line bg-surface p-2 shadow-2xl shadow-black/60">
          <ul class="flex flex-col text-sm">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} class="block rounded-md px-3 py-2.5 text-muted no-underline hover:bg-surface-2 hover:text-text">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
